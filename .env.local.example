# Copy this file to .env.local and fill in real values before enabling
# the Request a Quote email delivery. Until these are set, form
# submissions will fail with a clear "email not configured yet" error
# instead of silently going nowhere.

# API key from https://resend.com (or swap lib/email.ts for Oar's
# existing email provider).
RESEND_API_KEY=

# The inbox at Oar that should receive quote requests.
QUOTE_NOTIFY_TO=

# A "from" address on a domain verified in Resend. Falls back to
# Resend's onboarding sender (testing only) if left unset.
QUOTE_NOTIFY_FROM=
