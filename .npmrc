# Standard npm config (host-agnostic — honored by any npm install, on any
# platform). Added after a transient registry CDN hiccup served a corrupted
# tarball during a build: npm's default of 2 retries gave up too quickly.
# Raising retries/backoff gives flaky registry responses more chances to
# resolve on their own before failing the install.
fetch-retries=5
fetch-retry-mintimeout=20000
fetch-retry-maxtimeout=120000
